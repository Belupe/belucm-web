# Copia este fichero a .env y rellena los valores.

# Base de datos: PostgreSQL del sistema, por socket Unix.
DATABASE_URL=postgres://belucm:CLAVE@/belucm?host=/var/run/postgresql

# Clave con la que se firman las cookies de sesion del panel.
# Generala con: openssl rand -hex 32
SESSION_SECRET=

# Usuario administrador que se crea la primera vez que arranca la app,
# solo si la base de datos esta vacia. Despues se cambia desde el panel.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Contenido inicial (solo se usa al crear la base de datos vacia)
SITE_NOMBRE=belucm
SITE_EMAIL=

# Carpeta donde se guardan las imagenes subidas desde el panel
UPLOAD_DIR=/home/nach/belucm-web/data/uploads

# Puerto de escucha
PORT=3090
NODE_ENV=production
